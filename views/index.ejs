<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>موقع القرآن الكريم والمحاضرات</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background: linear-gradient(135deg, #0f2e1b 0%, #1b4d3e 50%, #2c5e4a 100%); margin: 0; padding: 20px; color: #f9f9f9; min-height: 100vh; text-align: center; }
        .header-box { background: linear-gradient(135deg, #12372a 0%, #436850 100%); color: #fbfada; padding: 25px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); margin-bottom: 20px; border: 2px solid #adbc9f; }
        .header-box h1 { font-family: 'Amiri', serif; font-size: 26px; margin: 0; }
        
        .grid-menu { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 25px; }
        .menu-btn { background: #12372a; border: 1px solid #436850; padding: 18px; border-radius: 14px; color: #fbfada; font-weight: bold; font-size: 16px; text-decoration: none; box-shadow: 0 4px 15px rgba(0,0,0,0.2); transition: 0.2s; }
        .menu-btn:hover { background: #1b4d3e; border-color: #d4af37; }

        .content-box { background: rgba(18, 55, 42, 0.9); backdrop-filter: blur(10px); padding: 20px; border-radius: 16px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); border: 1px solid #436850; margin-bottom: 20px; text-align: right; }
        .content-box h3 { font-family: 'Amiri', serif; color: #fbfada; font-size: 20px; margin-top: 0; text-align: center; }
        .item-card { background: #1b4d3e; padding: 15px; border-radius: 12px; margin-top: 10px; border: 1px solid #436850; text-align: right; }
        audio { width: 100%; margin-top: 10px; }
        
        .admin-login-section { text-align: center; margin-top: 20px; padding: 10px; }
        .admin-trigger { background: none; border: none; color: #adbc9f; cursor: pointer; font-size: 13px; text-decoration: underline; }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>موقع القرآن الكريم والمحاضرات</h1>
    </div>

    <!-- أزرار التنقل بين الأقسام -->
    <div class="grid-menu">
        <a href="/audios" class="menu-btn">🎧 الصوتيات</a>
        <a href="/articles" class="menu-btn">📝 المقالات</a>
        <a href="/books" class="menu-btn">📚 الكتب والرسائل</a>
        <a href="/fatwa" class="menu-btn">💡 الفتاوى</a>
    </div>

    <!-- قسم آخر الصوتيات والمحاضرات -->
    <div class="content-box">
        <h3>آخر الصوتيات والمحاضرات</h3>
        <div>
            <% if (locals.audios && audios.length > 0) { %>
                <% const latestAudio = audios[0]; %>
                <div class="item-card">
                    <div style="font-weight: bold; color: #fbfada;">🔊 <%= latestAudio.title %></div>
                    <% if (latestAudio.url) { %>
                        <audio controls src="<%= latestAudio.url %>"></audio>
                    <% } %>
                    <div style="font-size: 11px; color: #adbc9f; margin-top: 5px;"><%= latestAudio.date %></div>
                </div>
            <% } else { %>
                <p style="color: #d0e1d4; text-align: center; margin: 10px 0;">لا توجد صوتيات مرفوعة حالياً.</p>
            <% } %>
        </div>
    </div>

    <div class="admin-login-section">
        <button class="admin-trigger" onclick="location.href='/audios'">➕ الانتقال لقسم الصوتيات للرفع</button>
    </div>
</body>
</html>
