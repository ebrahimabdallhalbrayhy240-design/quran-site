<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المكتبة الصوتية - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f2e1b 0%, #1b4d3e 50%, #2c5e4a 100%);
            margin: 0;
            padding: 20px;
            color: #f9f9f9;
            min-height: 100vh;
        }
        .header-box {
            background: linear-gradient(135deg, #12372a 0%, #436850 100%);
            color: #fbfada;
            padding: 30px 20px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            margin-bottom: 25px;
            border: 2px solid #adbc9f;
        }
        .header-box h1 {
            font-family: 'Amiri', serif;
            font-size: 30px;
            margin: 0;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
        }
        .back-link {
            display: inline-block;
            margin-top: 10px;
            color: #adbc9f;
            text-decoration: none;
            font-weight: bold;
        }
        .content-box {
            background: rgba(18, 55, 42, 0.9);
            backdrop-filter: blur(10px);
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            border: 1px solid #436850;
            margin-bottom: 20px;
        }
        .content-box h3 {
            font-family: 'Amiri', serif;
            color: #fbfada;
            font-size: 22px;
            margin-top: 0;
        }
        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid #436850;
            background: #0f2e1b;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            box-sizing: border-box;
        }
        input:focus {
            outline: none;
            border-color: #d4af37;
        }
        .action-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            color: #ffffff;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }
        .progress-container {
            width: 100%;
            background: #0f2e1b;
            border-radius: 10px;
            margin-top: 15px;
            display: none;
            overflow: hidden;
            border: 1px solid #436850;
        }
        .progress-bar {
            width: 0%;
            height: 20px;
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            text-align: center;
            color: #fff;
            font-size: 12px;
            line-height: 20px;
            font-weight: bold;
            transition: width 0.3s;
        }
        .alert {
            background: #2e7d32;
            color: white;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 15px;
            display: none;
        }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>المكتبة الصوتية</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <div class="content-box">
        <h3>رفع صوتية جديدة</h3>
        <div id="successAlert" class="alert">تم رفع الصوتية بنجاح!</div>
        
        <form id="uploadForm">
            <input type="text" id="audioTitle" placeholder="عنوان الصوتية أو المحاضرة..." required>
            <input type="file" id="audioFile" accept="audio/*" style="padding: 10px; background: #1b4d3e;" required>
            <button type="submit" class="action-btn">🎙️ رفع الصوتية</button>
        </form>

        <div class="progress-container" id="progressContainer">
            <div class="progress-bar" id="progressBar">0%</div>
        </div>
    </div>

    <div class="content-box" style="text-align: center;">
        <h3>الصوتيات المنشورة</h3>
        <p style="color: #d0e1d4;">لا توجد صوتيات مرفوعة حالياً.</p>
    </div>

    <script>
        const form = document.getElementById('uploadForm');
        const progressBar = document.getElementById('progressBar');
        const progressContainer = document.getElementById('progressContainer');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('audioTitle').value;
            const fileInput = document.getElementById('audioFile').files[0];

            if (!fileInput) {
                alert('الرجاء اختيار ملف صوتي أولاً');
                return;
            }

            const formData = new FormData();
            formData.append('title', title);
            formData.append('audioFile', fileInput);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/audios', true);

            progressContainer.style.display = 'block';

            xhr.upload.onprogress = function(e) {
                if (e.lengthComputable) {
                    const percentComplete = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = percentComplete + '%';
                    progressBar.innerHTML = percentComplete + '%';
                }
            };

            xhr.onload = function() {
                if (xhr.status === 200) {
                    successAlert.style.display = 'block';
                    form.reset();
                    setTimeout(() => {
                        progressContainer.style.display = 'none';
                        progressBar.style.width = '0%';
                    }, 3000);
                } else {
                    alert('حدث خطأ أثناء الرفع، حاول مرة أخرى.');
                    progressContainer.style.display = 'none';
                }
            };

            xhr.send(formData);
        });
    </script>
</body>
</html>
