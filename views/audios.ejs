<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المكتبة الصوتية - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f2e1b 0%, #1b4d3e 50%, #2c5e4a 100%);
            margin: 0;
            padding: 20px;
            color: #f9f9f9;
            min-height: 100vh;
        }
        .header-box {
            background: linear-gradient(135deg, #12372a 0%, #436850 100%);
            color: #fbfada;
            padding: 30px 20px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            margin-bottom: 25px;
            border: 2px solid #adbc9f;
        }
        .header-box h1 {
            font-family: 'Amiri', serif;
            font-size: 30px;
            margin: 0;
            text-shadow: 2px 2px 5px rgba(0,0,0,0.5);
        }
        .back-link {
            display: inline-block;
            margin-top: 10px;
            color: #adbc9f;
            text-decoration: none;
            font-weight: bold;
        }
        .content-box {
            background: rgba(18, 55, 42, 0.9);
            backdrop-filter: blur(10px);
            padding: 25px;
            border-radius: 16px;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3);
            border: 1px solid #436850;
            margin-bottom: 20px;
        }
        .content-box h3 {
            font-family: 'Amiri', serif;
            color: #fbfada;
            font-size: 22px;
            margin-top: 0;
        }
        input {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 10px;
            border: 1px solid #436850;
            background: #0f2e1b;
            color: #fff;
            font-family: 'Cairo', sans-serif;
            box-sizing: border-box;
        }
        input:focus {
            outline: none;
            border-color: #d4af37;
        }
        .action-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            color: #ffffff;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }
        .alert {
            background: #2e7d32;
            color: white;
            padding: 10px;
            border-radius: 8px;
            text-align: center;
            margin-bottom: 15px;
            display: none;
        }
        .audio-item {
            background: #1b4d3e;
            padding: 12px 15px;
            border-radius: 10px;
            margin-top: 10px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border: 1px solid #436850;
        }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>المكتبة الصوتية</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <div class="content-box">
        <h3>إضافة صوتية جديدة</h3>
        <div id="successAlert" class="alert">تمت إضافة الصوتية بنجاح!</div>
        
        <form id="uploadForm">
            <input type="text" id="audioTitle" placeholder="عنوان الصوتية أو المحاضرة..." required>
            <input type="file" id="audioFile" accept="audio/*" style="padding: 10px; background: #1b4d3e;" required>
            <button type="submit" class="action-btn">🎙️ نشر الصوتية</button>
        </form>
    </div>

    <div class="content-box">
        <h3>الصوتيات المنشورة</h3>
        <div id="audiosListContainer">
            <% if (locals.audios && audios.length > 0) { %>
                <% audios.forEach(audio => { %>
                    <div class="audio-item">
                        <span>🎵 <%= audio.title %></span>
                        <span style="font-size: 12px; color: #adbc9f;"><%= audio.date %></span>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #d0e1d4; text-align: center;">لا توجد صوتيات مرفوعة حالياً.</p>
            <% } %>
        </div>
    </div>

    <script>
        const form = document.getElementById('uploadForm');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('audioTitle').value;
            const fileInput = document.getElementById('audioFile').files[0];

            if (!fileInput) {
                alert('الرجاء اختيار ملف صوتي أولاً');
                return;
            }

            // إرسال البيانات بشكل آمن وسريع عبر JSON لتجنب مشاكل الاستضافة
            fetch('/audios', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: title + ' (' + fileInput.name + ')' })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    successAlert.style.display = 'block';
                    form.reset();
                    setTimeout(() => {
                        location.reload();
                    }, 1500);
                }
            })
            .catch(err => {
                alert('حدث خطأ، حاول مرة أخرى.');
            });
        });
    </script>
</body>
</html>
