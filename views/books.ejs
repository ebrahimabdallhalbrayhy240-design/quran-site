<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مكتبة الكتب والرسائل - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            background: linear-gradient(135deg, #0f2e1b 0%, #1b4d3e 50%, #2c5e4a 100%);
            margin: 0; padding: 20px; color: #f9f9f9; min-height: 100vh;
        }
        .header-box {
            background: linear-gradient(135deg, #12372a 0%, #436850 100%);
            color: #fbfada; padding: 30px 20px; border-radius: 20px; text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); margin-bottom: 25px; border: 2px solid #adbc9f;
        }
        .header-box h1 { font-family: 'Amiri', serif; font-size: 30px; margin: 0; }
        .back-link { display: inline-block; margin-top: 10px; color: #adbc9f; text-decoration: none; font-weight: bold; }
        .content-box {
            background: rgba(18, 55, 42, 0.9); backdrop-filter: blur(10px); padding: 25px;
            border-radius: 16px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); border: 1px solid #436850; margin-bottom: 20px;
        }
        .content-box h3 { font-family: 'Amiri', serif; color: #fbfada; font-size: 22px; margin-top: 0; }
        input[type="text"] { width: 100%; padding: 12px; margin: 10px 0; border-radius: 10px; border: 1px solid #436850; background: #0f2e1b; color: #fff; box-sizing: border-box; }
        input[type="file"] { width: 100%; padding: 12px; margin: 10px 0; border-radius: 10px; border: 1px solid #436850; background: #1b4d3e; color: #fbfada; box-sizing: border-box; cursor: pointer; }
        .action-btn { background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%); color: #fff; width: 100%; padding: 14px; border-radius: 12px; border: none; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .progress-container { width: 100%; background: #0f2e1b; border-radius: 10px; margin-top: 15px; display: none; overflow: hidden; border: 1px solid #436850; }
        .progress-bar { width: 0%; height: 22px; background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%); text-align: center; color: #fff; font-size: 13px; line-height: 22px; font-weight: bold; }
        .alert { background: #2e7d32; color: white; padding: 10px; border-radius: 8px; text-align: center; margin-bottom: 15px; display: none; }
        .item-card { background: #1b4d3e; padding: 15px; border-radius: 12px; margin-top: 15px; border: 1px solid #436850; }
        .btn-group { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
        .custom-btn { display: inline-block; background: #2c5e4a; color: #fbfada; padding: 6px 14px; border-radius: 6px; text-decoration: none; font-size: 13px; border: 1px solid #adbc9f; font-weight: bold; }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>الكتب والرسائل</h1>
        <a href="/?key=ibrahim123" class="back-link">← العودة للرئيسية</a>
    </div>

    <% if (locals.isAdmin) { %>
    <div class="content-box">
        <h3>إضافة كتاب أو رسالة جديدة (لوحة التحكم الخاصة بك)</h3>
        <div id="successAlert" class="alert">تمت إضافة الكتاب بنجاح!</div>
        <form id="uploadForm">
            <input type="text" id="bookTitle" placeholder="عنوان الكتاب أو الرسالة..." required>
            <input type="file" id="bookFile" required>
            <button type="submit" class="action-btn">📚 رفع ونشر الكتاب</button>
        </form>
        <div class="progress-container" id="progressContainer">
            <div class="progress-bar" id="progressBar">0%</div>
        </div>
    </div>
    <% } %>

    <div class="content-box">
        <h3>الكتب والرسائل المنشورة</h3>
        <div>
            <% if (locals.books && books.length > 0) { %>
                <% books.forEach(book => { %>
                    <div class="item-card">
                        <div style="font-weight: bold; color: #fbfada; font-size: 16px;">📖 <%= book.title %></div>
                        <% if (book.url) { %>
                            <div class="btn-group">
                                <a href="<%= book.url %>" target="_blank" class="custom-btn">👁️ تصفح وقراءة</a>
                                <a href="<%= book.url %>" download="<%= book.title %>" class="custom-btn">📥 تحميل وتنزيل</a>
                            </div>
                        <% } %>
                        <div style="font-size: 11px; color: #adbc9f; margin-top: 8px;"><%= book.date %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #d0e1d4; text-align: center;">لا توجد كتب مرفوعة حالياً.</p>
            <% } %>
        </div>
    </div>

    <% if (locals.isAdmin) { %>
    <script>
        const form = document.getElementById('uploadForm');
        const progressBar = document.getElementById('progressBar');
        const progressContainer = document.getElementById('progressContainer');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('bookTitle').value;
            const fileInput = document.getElementById('bookFile').files[0];
            if (!fileInput) return;

            progressContainer.style.display = 'block';
            let progress = 0;
            const interval = setInterval(() => {
                progress += 15;
                if (progress <= 90) { progressBar.style.width = progress + '%'; progressBar.textContent = progress + '%'; }
            }, 100);

            const reader = new FileReader();
            reader.onload = function(event) {
                fetch('/books?key=ibrahim123', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ title: title, url: event.target.result })
                })
                .then(res => res.json())
                .then(data => {
                    clearInterval(interval);
                    progressBar.style.width = '100%'; progressBar.textContent = '100%';
                    if (data.success) {
                        successAlert.style.display = 'block';
                        form.reset();
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        alert(data.message || 'خطأ في الصلاحيات');
                    }
                });
            };
            reader.readAsDataURL(fileInput);
        });
    </script>
    <% } %>
</body>
</html>
