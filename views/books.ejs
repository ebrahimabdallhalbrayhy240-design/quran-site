<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>الكتب والرسائل - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Cairo', sans-serif; background: linear-gradient(135deg, #0f2e1b 0%, #1b4d3e 50%, #2c5e4a 100%); margin: 0; padding: 20px; color: #f9f9f9; min-height: 100vh; }
        .header-box { background: linear-gradient(135deg, #12372a 0%, #436850 100%); color: #fbfada; padding: 30px 20px; border-radius: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4); margin-bottom: 25px; border: 2px solid #adbc9f; }
        .header-box h1 { font-family: 'Amiri', serif; font-size: 30px; margin: 0; }
        .back-link { display: inline-block; margin-top: 10px; color: #adbc9f; text-decoration: none; font-weight: bold; }
        .content-box { background: rgba(18, 55, 42, 0.9); backdrop-filter: blur(10px); padding: 25px; border-radius: 16px; box-shadow: 0 8px 25px rgba(0, 0, 0, 0.3); border: 1px solid #436850; margin-bottom: 20px; }
        .content-box h3 { font-family: 'Amiri', serif; color: #fbfada; font-size: 22px; margin-top: 0; }
        input[type="text"], input[type="file"] { width: 100%; padding: 12px; margin: 10px 0; border-radius: 10px; border: 1px solid #436850; background: #0f2e1b; color: #fff; box-sizing: border-box; }
        input[type="file"] { cursor: pointer; }
        .action-btn { background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%); color: #fff; width: 100%; padding: 14px; border-radius: 12px; border: none; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .alert { background: #2e7d32; color: white; padding: 10px; border-radius: 8px; text-align: center; margin-bottom: 15px; display: none; }
        .item-card { background: #1b4d3e; padding: 15px; border-radius: 12px; margin-top: 15px; border: 1px solid #436850; }
        .custom-btn { display: inline-block; background: #2c5e4a; color: #fbfada; padding: 8px 14px; border-radius: 8px; text-decoration: none; font-size: 13px; border: 1px solid #adbc9f; font-weight: bold; margin-top: 8px; }
        .admin-login-section { text-align: center; margin-top: 30px; padding: 15px; border-top: 1px dashed #436850; }
        .admin-trigger { background: none; border: none; color: #adbc9f; cursor: pointer; font-size: 13px; text-decoration: underline; }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>الكتب والرسائل</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <!-- صندوق إضافة كتاب مخفي -->
    <div class="content-box" id="uploadBox" style="display: none;">
        <h3>إضافة كتاب جديد من الهاتف</h3>
        <div id="successAlert" class="alert">تمت إضافة الكتاب بنجاح!</div>
        <form id="uploadForm">
            <input type="text" id="bookTitle" placeholder="عنوان الكتاب..." required>
            <input type="file" id="bookFile" required>
            <button type="submit" class="action-btn">📚 رفع ونشر الكتاب</button>
        </form>
    </div>

    <div class="content-box">
        <h3>الكتب والرسائل المنشورة</h3>
        <div>
            <% if (locals.books && books.length > 0) { %>
                <% books.forEach(book => { %>
                    <div class="item-card">
                        <div style="font-weight: bold; color: #fbfada; font-size: 16px;">📖 <%= book.title %></div>
                        <% if (book.url) { %>
                            <div>
                                <a href="<%= book.url %>" target="_blank" class="custom-btn">🔗 فتح الملف</a>
                            </div>
                        <% } %>
                        <div style="font-size: 11px; color: #adbc9f; margin-top: 8px;"><%= book.date %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: #d0e1d4; text-align: center;">لا توجد كتب مرفوعة حالياً.</p>
            <% } %>
        </div>
    </div>

    <div class="admin-login-section">
        <button class="admin-trigger" onclick="unlockAdmin()">🔒 تسجيل دخول المشرف للإضافة</button>
    </div>

    <script>
        let adminPassword = '';
        function unlockAdmin() {
            const pass = prompt('الرجاء إدخال كلمة مرور المشرف:');
            if (pass) {
                adminPassword = pass;
                document.getElementById('uploadBox').style.display = 'block';
                alert('تم تفعيل وضع المشرف بنجاح!');
            }
        }

        const form = document.getElementById('uploadForm');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('bookTitle').value;
            const fileInput = document.getElementById('bookFile');
            
            if (fileInput.files.length > 0) {
                const fileName = fileInput.files[0].name;
                // محاكاة رفع الملف محلياً باسم الملف المختار لتسهيل الاستخدام
                const fakeUrl = '#' + encodeURIComponent(fileName);

                fetch('/books', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'x-admin-pass': adminPassword },
                    body: JSON.stringify({ title: title, url: fakeUrl })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        successAlert.style.display = 'block';
                        form.reset();
                        setTimeout(() => location.reload(), 1000);
                    } else {
                        alert(data.message || 'كلمة المرور خاطئة!');
                    }
                });
            }
        });
    </script>
</body>
</html>
