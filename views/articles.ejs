<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المقالات والبحوث - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #04120a;
            --bg-gradient: linear-gradient(145deg, #05190e 0%, #0d301d 50%, #13462a 100%);
            --box-bg: rgba(13, 48, 29, 0.85);
            --gold: #f8efba;
            --gold-bright: #ffdf00;
            --gold-border: rgba(248, 239, 186, 0.5);
            --text-light: #ffffff;
            --text-muted: #b8c5bc;
            --glow-gold: 0 0 20px rgba(255, 223, 0, 0.25);
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg-deep);
            background-image: var(--bg-gradient);
            margin: 0;
            padding: 20px;
            color: var(--text-light);
            min-height: 100vh;
        }

        .header-box {
            background: linear-gradient(135deg, #0d301d 0%, #175232 100%);
            color: var(--gold);
            padding: 30px 20px;
            border-radius: 22px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), var(--glow-gold);
            margin-bottom: 25px;
            border: 2px solid var(--gold-border);
        }

        .header-box h1 {
            font-family: 'Amiri', serif;
            font-size: 30px;
            margin: 0;
            color: var(--gold-bright);
            text-shadow: 0 2px 5px rgba(0,0,0,0.4);
        }

        .back-link {
            display: inline-block;
            margin-top: 10px;
            color: var(--gold);
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
        }

        .content-box {
            background: var(--box-bg);
            backdrop-filter: blur(14px);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            border: 1px solid var(--gold-border);
            margin-bottom: 20px;
        }

        .content-box h3 {
            font-family: 'Amiri', serif;
            color: var(--gold);
            font-size: 22px;
            margin-top: 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 12px;
            border: 1px solid var(--gold-border);
            background: #061c10;
            color: #fff;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
        }

        textarea {
            resize: vertical;
            min-height: 120px;
        }

        .action-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            color: #fff;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            font-size: 16px;
            font-family: 'Amiri', serif;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .alert {
            background: #2e7d32;
            color: white;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 15px;
            display: none;
        }

        .item-card {
            background: linear-gradient(135deg, #0d301d 0%, #15452b 100%);
            padding: 18px;
            border-radius: 16px;
            margin-top: 15px;
            border: 1px solid var(--gold-border);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .admin-login-section {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            border-top: 1px dashed var(--gold-border);
        }

        .admin-trigger {
            background: none;
            border: none;
            color: var(--gold);
            cursor: pointer;
            font-size: 13px;
            text-decoration: underline;
            font-family: 'Cairo', sans-serif;
        }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>المقالات والبحوث</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <!-- صندوق إضافة مقال مخفي للمشرف -->
    <div class="content-box" id="uploadBox" style="display: none;">
        <h3>إضافة مقال جديد</h3>
        <div id="successAlert" class="alert">تم نشر المقال بنجاح!</div>
        <form id="uploadForm">
            <input type="text" id="articleTitle" placeholder="عنوان المقال..." required>
            <textarea id="articleContent" placeholder="نص المقال أو المحتوى..." required></textarea>
            <button type="submit" class="action-btn">📝 نشر المقال</button>
        </form>
    </div>

    <div class="content-box">
        <h3>المقالات المنشورة</h3>
        <div>
            <% if (locals.articles && articles.length > 0) { %>
                <% articles.forEach(art => { %>
                    <div class="item-card">
                        <div style="font-weight: bold; color: var(--gold); font-size: 18px; font-family: 'Amiri', serif;"><%= art.title %></div>
                        <div style="color: var(--text-light); font-size: 14px; margin-top: 10px; line-height: 1.6; white-space: pre-line;"><%= art.content %></div>
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 10px;"><%= art.date %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-muted); text-align: center;">لا توجد مقالات منشورة حالياً.</p>
            <% } %>
        </div>
    </div>

    <div class="admin-login-section">
        <button class="admin-trigger" onclick="unlockAdmin()">🔒 تسجيل دخول المشرف للإضافة</button>
    </div>

    <script>
        let adminPassword = '';
        function unlockAdmin() {
            const pass = prompt('الرجاء إدخال كلمة مرور المشرف:');
            if (pass) {
                adminPassword = pass;
                document.getElementById('uploadBox').style.display = 'block';
                alert('تم تفعيل وضع المشرف بنجاح!');
            }
        }

        const form = document.getElementById('uploadForm');
        const successAlert = document.getElementById('successAlert');

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('articleTitle').value;
            const content = document.getElementById('articleContent').value;

            fetch('/articles', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'x-admin-pass': adminPassword },
                body: JSON.stringify({ title: title, content: content })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    successAlert.style.display = 'block';
                    form.reset();
                    setTimeout(() => location.reload(), 1000);
                } else {
                    alert(data.message || 'كلمة المرور خاطئة!');
                }
            });
        });
    </script>
</body>
</html>
