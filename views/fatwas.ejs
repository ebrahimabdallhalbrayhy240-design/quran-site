<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>قسم الفتاوى - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #04120a;
            --bg-gradient: linear-gradient(145deg, #05190e 0%, #0d301d 50%, #13462a 100%);
            --box-bg: rgba(13, 48, 29, 0.85);
            --gold: #f8efba;
            --gold-bright: #ffdf00;
            --gold-border: rgba(248, 239, 186, 0.5);
            --text-light: #ffffff;
            --text-muted: #b8c5bc;
            --glow-gold: 0 0 20px rgba(255, 223, 0, 0.25);
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg-deep);
            background-image: var(--bg-gradient);
            margin: 0;
            padding: 20px;
            color: var(--text-light);
            min-height: 100vh;
        }

        .header-box {
            background: linear-gradient(135deg, #0d301d 0%, #175232 100%);
            color: var(--gold);
            padding: 30px 20px;
            border-radius: 22px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), var(--glow-gold);
            margin-bottom: 25px;
            border: 2px solid var(--gold-border);
        }

        .header-box h1 {
            font-family: 'Amiri', serif;
            font-size: 30px;
            margin: 0;
            color: var(--gold-bright);
            text-shadow: 0 2px 5px rgba(0,0,0,0.4);
        }

        .back-link {
            display: inline-block;
            margin-top: 10px;
            color: var(--gold);
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
        }

        .content-box {
            background: var(--box-bg);
            backdrop-filter: blur(14px);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            border: 1px solid var(--gold-border);
            margin-bottom: 20px;
        }

        .content-box h3 {
            font-family: 'Amiri', serif;
            color: var(--gold);
            font-size: 22px;
            margin-top: 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        input[type="text"], textarea {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 12px;
            border: 1px solid var(--gold-border);
            background: #061c10;
            color: #fff;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
        }

        textarea {
            resize: vertical;
            min-height: 120px;
        }

        .action-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            color: #fff;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            font-size: 16px;
            font-family: 'Amiri', serif;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        .progress-container {
            width: 100%;
            background: #061c10;
            border-radius: 12px;
            border: 1px solid var(--gold-border);
            margin-top: 15px;
            overflow: hidden;
            display: none;
            position: relative;
            height: 24px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #aa771c, #ffdf00);
            transition: width 0.1s ease;
            box-shadow: 0 0 10px rgba(255, 223, 0, 0.5);
        }

        .progress-text {
            position: absolute;
            width: 100%;
            top: 0;
            left: 0;
            text-align: center;
            font-size: 12px;
            font-weight: bold;
            color: #fff;
            line-height: 24px;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
        }

        .alert {
            background: #2e7d32;
            color: white;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 15px;
            display: none;
        }

        .item-card {
            background: linear-gradient(135deg, #0d301d 0%, #15452b 100%);
            padding: 18px;
            border-radius: 16px;
            margin-top: 15px;
            border: 1px solid var(--gold-border);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        .admin-login-section {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            border-top: 1px dashed var(--gold-border);
        }

        .admin-trigger {
            background: none;
            border: none;
            color: var(--gold);
            cursor: pointer;
            font-size: 13px;
            text-decoration: underline;
            font-family: 'Cairo', sans-serif;
        }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>قسم الفتاوى الشرعية</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <div class="content-box" id="uploadBox" style="display: none;">
        <h3>إضافة فتوى جديدة</h3>
        <div id="successAlert" class="alert">تم نشر الفتوى بنجاح!</div>
        <form id="uploadForm">
            <input type="text" id="fatwaTitle" placeholder="السؤال / عنوان الفتوى..." required>
            <textarea id="fatwaContent" placeholder="الإجابة / نص الفتوى..." required></textarea>
            <button type="submit" id="submitBtn" class="action-btn">💡 نشر الفتوى</button>
            
            <div class="progress-container" id="progressContainer">
                <div class="progress-bar" id="progressBar"></div>
                <div class="progress-text" id="progressText">0%</div>
            </div>
        </form>
    </div>

    <div class="content-box">
        <h3>الفتاوى المنشورة</h3>
        <div>
            <% if (locals.fatwas && fatwas.length > 0) { %>
                <% fatwas.forEach(fatwa => { %>
                    <div class="item-card">
                        <div style="font-weight: bold; color: var(--gold); font-size: 18px; font-family: 'Amiri', serif;">❓ <%= fatwa.title %></div>
                        <div style="color: var(--text-light); font-size: 14px; margin-top: 10px; line-height: 1.6; white-space: pre-line;"><%= fatwa.content %></div>
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 10px;"><%= fatwa.date %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-muted); text-align: center;">لا توجد فتاوى منشورة حالياً.</p>
            <% } %>
        </div>
    </div>

    <div class="admin-login-section">
        <button class="admin-trigger" onclick="unlockAdmin()">🔒 تسجيل دخول المشرف للإضافة</button>
    </div>

    <script>
        let adminPassword = '';
        function unlockAdmin() {
            const pass = prompt('الرجاء إدخال كلمة مرور المشرف:');
            if (pass === 'admin123') {
                adminPassword = pass;
                document.getElementById('uploadBox').style.display = 'block';
                alert('تم تفعيل وضع المشرف بنجاح!');
            } else {
                alert('كلمة المرور غير صحيحة!');
            }
        }

        const form = document.getElementById('uploadForm');
        const successAlert = document.getElementById('successAlert');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');
        const submitBtn = document.getElementById('submitBtn');

        let isUploading = false;

        window.addEventListener('beforeunload', function (e) {
            if (isUploading) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('fatwaTitle').value;
            const content = document.getElementById('fatwaContent').value;

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/fatwas', true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.setRequestHeader('x-admin-pass', adminPassword);

            progressContainer.style.display = 'block';
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            isUploading = true;

            let progress = 0;
            const interval = setInterval(() => {
                if (progress < 90) {
                    progress += 15;
                    progressBar.style.width = progress + '%';
                    progressText.textContent = 'جاري النشر... ' + progress + '%';
                }
            }, 50);

            xhr.onload = function() {
                clearInterval(interval);
                isUploading = false;
                progressBar.style.width = '100%';
                progressText.textContent = 'تم النشر بنجاح 100%!';

                if (xhr.status === 200) {
                    try {
                        const data = JSON.parse(xhr.responseText);
                        if (data.success) {
                            successAlert.style.display = 'block';
                            form.reset();
                            setTimeout(() => location.reload(), 1000);
                        } else {
                            alert(data.message || 'حدث خطأ!');
                            resetUploadUI();
                        }
                    } catch (err) {
                        alert('حدث خطأ في الاستجابة');
                        resetUploadUI();
                    }
                } else {
                    alert('كلمة المرور غير صحيحة أو حدث خطأ في الخادم!');
                    resetUploadUI();
                }
            };

            xhr.onerror = function() {
                clearInterval(interval);
                isUploading = false;
                alert('فشل الاتصال بالخادم');
                resetUploadUI();
            };

            xhr.send(JSON.stringify({ title: title, content: content, adminPass: adminPassword }));
        });

        function resetUploadUI() {
            progressContainer.style.display = 'none';
            progressBar.style.width = '0%';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
        }
    </script>
</body>
</html>
