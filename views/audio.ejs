<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>المكتبة الصوتية - موقع القرآن الكريم</title>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:wght@700&family=Cairo:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-deep: #04120a;
            --bg-gradient: linear-gradient(145deg, #05190e 0%, #0d301d 50%, #13462a 100%);
            --box-bg: rgba(13, 48, 29, 0.85);
            --gold: #f8efba;
            --gold-bright: #ffdf00;
            --gold-border: rgba(248, 239, 186, 0.5);
            --text-light: #ffffff;
            --text-muted: #b8c5bc;
            --glow-gold: 0 0 20px rgba(255, 223, 0, 0.25);
        }

        body {
            font-family: 'Cairo', sans-serif;
            background: var(--bg-deep);
            background-image: var(--bg-gradient);
            margin: 0;
            padding: 20px;
            color: var(--text-light);
            min-height: 100vh;
        }

        .header-box {
            background: linear-gradient(135deg, #0d301d 0%, #175232 100%);
            color: var(--gold);
            padding: 30px 20px;
            border-radius: 22px;
            text-align: center;
            box-shadow: 0 15px 35px rgba(0, 0, 0, 0.6), var(--glow-gold);
            margin-bottom: 25px;
            border: 2px solid var(--gold-border);
        }

        .header-box h1 {
            font-family: 'Amiri', serif;
            font-size: 30px;
            margin: 0;
            color: var(--gold-bright);
            text-shadow: 0 2px 5px rgba(0,0,0,0.4);
        }

        .back-link {
            display: inline-block;
            margin-top: 10px;
            color: var(--gold);
            text-decoration: none;
            font-weight: bold;
            font-size: 14px;
        }

        .content-box {
            background: var(--box-bg);
            backdrop-filter: blur(14px);
            padding: 25px;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            border: 1px solid var(--gold-border);
            margin-bottom: 20px;
        }

        .content-box h3 {
            font-family: 'Amiri', serif;
            color: var(--gold);
            font-size: 22px;
            margin-top: 0;
            text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        }

        input[type="text"], input[type="file"] {
            width: 100%;
            padding: 12px;
            margin: 10px 0;
            border-radius: 12px;
            border: 1px solid var(--gold-border);
            background: #061c10;
            color: #fff;
            box-sizing: border-box;
            font-family: 'Cairo', sans-serif;
        }

        .action-btn {
            background: linear-gradient(135deg, #d4af37 0%, #aa771c 100%);
            color: #fff;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
            font-weight: bold;
            cursor: pointer;
            margin-top: 10px;
            font-size: 16px;
            font-family: 'Amiri', serif;
            box-shadow: 0 5px 15px rgba(212, 175, 55, 0.3);
        }

        /* تصميم شريط التقدم الساحر */
        .progress-container {
            width: 100%;
            background: #061c10;
            border-radius: 12px;
            border: 1px solid var(--gold-border);
            margin-top: 15px;
            overflow: hidden;
            display: none;
            position: relative;
            height: 24px;
        }

        .progress-bar {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #aa771c, #ffdf00);
            transition: width 0.1s ease;
            box-shadow: 0 0 10px rgba(255, 223, 0, 0.5);
        }

        .progress-text {
            position: absolute;
            width: 100%;
            top: 0;
            left: 0;
            text-align: center;
            font-size: 12px;
            font-weight: bold;
            color: #fff;
            line-height: 24px;
            text-shadow: 0 1px 2px rgba(0,0,0,0.8);
        }

        .alert {
            background: #2e7d32;
            color: white;
            padding: 10px;
            border-radius: 10px;
            text-align: center;
            margin-bottom: 15px;
            display: none;
        }

        .item-card {
            background: linear-gradient(135deg, #0d301d 0%, #15452b 100%);
            padding: 18px;
            border-radius: 16px;
            margin-top: 15px;
            border: 1px solid var(--gold-border);
            box-shadow: 0 5px 15px rgba(0,0,0,0.3);
        }

        audio {
            width: 100%;
            margin-top: 12px;
            border-radius: 8px;
        }

        .custom-btn {
            display: inline-block;
            background: #175232;
            color: var(--gold);
            padding: 8px 14px;
            border-radius: 10px;
            text-decoration: none;
            font-size: 13px;
            border: 1px solid var(--gold-border);
            font-weight: bold;
            margin-top: 10px;
        }

        .admin-login-section {
            text-align: center;
            margin-top: 30px;
            padding: 15px;
            border-top: 1px dashed var(--gold-border);
        }

        .admin-trigger {
            background: none;
            border: none;
            color: var(--gold);
            cursor: pointer;
            font-size: 13px;
            text-decoration: underline;
            font-family: 'Cairo', sans-serif;
        }
    </style>
</head>
<body>
    <div class="header-box">
        <h1>المكتبة الصوتية والمحاضرات</h1>
        <a href="/" class="back-link">← العودة للرئيسية</a>
    </div>

    <!-- صندوق إضافة صوتية مخفي للمشرف -->
    <div class="content-box" id="uploadBox" style="display: none;">
        <h3>إضافة مقطع صوتي جديد</h3>
        <div id="successAlert" class="alert">تمت إضافة المقطع بنجاح!</div>
        <form id="uploadForm">
            <input type="text" id="audioTitle" placeholder="عنوان المقطع (مثلاً: سورة الفاتحة)..." required>
            <label style="font-size: 13px; color: var(--gold);">اختر الملف الصوتي من الجهاز:</label>
            <input type="file" id="audioFile" accept="audio/*" required>
            <button type="submit" id="submitBtn" class="action-btn">🎧 نشر المقطع الصوتي</button>
            
            <!-- شريط التقدم -->
            <div class="progress-container" id="progressContainer">
                <div class="progress-bar" id="progressBar"></div>
                <div class="progress-text" id="progressText">0%</div>
            </div>
        </form>
    </div>

    <div class="content-box">
        <h3>المقاطع الصوتية المنشورة</h3>
        <div>
            <% if (locals.audios && audios.length > 0) { %>
                <% audios.forEach(audio => { %>
                    <div class="item-card">
                        <div style="font-weight: bold; color: var(--gold); font-size: 18px; font-family: 'Amiri', serif;">🔊 <%= audio.title %></div>
                        <% if (audio.url) { %>
                            <audio controls>
                                <source src="<%= audio.url %>" type="audio/mpeg">
                                متصفحك لا يدعم مشغل الصوت
                            </audio>
                            <div>
                                <a href="<%= audio.url %>" target="_blank" class="custom-btn">📥 تحميل الملف الصوتي</a>
                            </div>
                        <% } %>
                        <div style="font-size: 11px; color: var(--text-muted); margin-top: 8px;"><%= audio.date %></div>
                    </div>
                <% }) %>
            <% } else { %>
                <p style="color: var(--text-muted); text-align: center;">لا توجد مقاطع صوتية مرفوعة حالياً.</p>
            <% } %>
        </div>
    </div>

    <div class="admin-login-section">
        <button class="admin-trigger" onclick="unlockAdmin()">🔒 تسجيل دخول المشرف للإضافة</button>
    </div>

    <script>
        let adminPassword = '';
        function unlockAdmin() {
            const pass = prompt('الرجاء إدخال كلمة مرور المشرف:');
            if (pass === 'admin123') {
                adminPassword = pass;
                document.getElementById('uploadBox').style.display = 'block';
                alert('تم تفعيل وضع المشرف بنجاح!');
            } else {
                alert('كلمة المرور غير صحيحة!');
            }
        }

        const form = document.getElementById('uploadForm');
        const successAlert = document.getElementById('successAlert');
        const progressContainer = document.getElementById('progressContainer');
        const progressBar = document.getElementById('progressBar');
        const progressText = document.getElementById('progressText');
        const submitBtn = document.getElementById('submitBtn');

        let isUploading = false;

        // تنبيه ذكي لمنع إغلاق الصفحة أثناء الرفع
        window.addEventListener('beforeunload', function (e) {
            if (isUploading) {
                e.preventDefault();
                e.returnValue = '';
            }
        });

        form.addEventListener('submit', function(e) {
            e.preventDefault();
            const title = document.getElementById('audioTitle').value;
            const fileInput = document.getElementById('audioFile').files[0];

            if (!fileInput) return;

            const formData = new FormData();
            formData.append('title', title);
            formData.append('audioFile', fileInput);
            formData.append('adminPass', adminPassword);

            const xhr = new XMLHttpRequest();
            xhr.open('POST', '/audio', true);
            xhr.setRequestHeader('x-admin-pass', adminPassword);

            progressContainer.style.display = 'block';
            submitBtn.disabled = true;
            submitBtn.style.opacity = '0.5';
            isUploading = true;

            // تتبع نسبة الرفع من 0 إلى 100%
            xhr.upload.addEventListener('progress', function(e) {
                if (e.lengthComputable) {
                    const percentComplete = Math.round((e.loaded / e.total) * 100);
                    progressBar.style.width = percentComplete + '%';
                    progressText.textContent = 'جاري الرفع... ' + percentComplete + '%';
                }
            });

            xhr.onload = function() {
                isUploading = false;
                if (xhr.status === 200) {
                    try {
                        const data = JSON.parse(xhr.responseText);
                        if (data.success) {
                            successAlert.style.display = 'block';
                            progressText.textContent = 'تم الرفع بنجاح 100%!';
                            form.reset();
                            setTimeout(() => location.reload(), 1200);
                        } else {
                            alert(data.message || 'حدث خطأ!');
                            resetUploadUI();
                        }
                    } catch (err) {
                        alert('حدث خطأ في الاستجابة');
                        resetUploadUI();
                    }
                } else {
                    isUploading = false;
                    alert('كلمة المرور غير صحيحة أو حدث خطأ في الخادم!');
                    resetUploadUI();
                }
            };

            xhr.onerror = function() {
                isUploading = false;
                alert('فشل الاتصال بالخادم');
                resetUploadUI();
            };

            xhr.send(formData);
        });

        function resetUploadUI() {
            progressContainer.style.display = 'none';
            progressBar.style.width = '0%';
            submitBtn.disabled = false;
            submitBtn.style.opacity = '1';
        }
    </script>
</body>
</html>
